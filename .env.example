# ── Database ────────────────────────────────────────────────────────────────
# Local development (SQLite, no setup needed):
DATABASE_URL="file:./dev.db"

# For deployment later (PostgreSQL, e.g. Neon):
# DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── AI (Phase B — entirely optional, app works without these) ───────────────
# Provider abstraction: nothing is hard-coded. Leave unset to use the
# deterministic local rule engine only.
# AI_PROVIDER="openai"        # openai | anthropic | ollama (any OpenAI-compatible base URL)
# AI_MODEL="gpt-4o-mini"      # any model the provider supports
# AI_BASE_URL=""              # optional override (e.g. http://localhost:11434/v1 for Ollama)
# AI_API_KEY=""               # required for hosted providers, not for local ones
