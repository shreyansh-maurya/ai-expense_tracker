generator client {
  provider = "prisma-client-js"
}

// Production (Vercel + Neon) schema — identical models to ../schema.prisma
// (SQLite, local dev) with a postgresql datasource. DATABASE_URL is the Neon
// pooled string (runtime); DIRECT_URL is the unpooled string (migrations).
// Keep this file in sync with ../schema.prisma — models must match exactly.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id         String    @id @default(cuid())
  name       String    @unique
  color      String // hex, e.g. "#f97316"
  icon       String? // lucide icon name (for future use)
  keywords   String? // comma-separated, powers deterministic categorization
  isDefault  Boolean   @default(false)
  isArchived Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  expenses          Expense[]
  budgets           Budget[]
  recurringExpenses RecurringExpense[]
}

model Expense {
  id            String   @id @default(cuid())
  amountPaise   Int // integer paise, never floats
  date          DateTime // UTC midnight of the calendar date
  categoryId    String
  paymentMethod String // CASH | CARD | UPI | NET_BANKING | WALLET | OTHER
  merchant      String?
  merchantNorm  String? // lowercase merchant for search + rule matching
  notes         String?
  categorizedBy String   @default("USER") // USER | RULE | AI
  recurringId   String? // set when materialized from a RecurringExpense template
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  category         Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  recurringExpense RecurringExpense? @relation(fields: [recurringId], references: [id], onDelete: SetNull)

  @@index([date])
  @@index([merchantNorm])
  @@index([categoryId, date])
  @@unique([recurringId, date]) // one materialized row per occurrence — makes runs idempotent
}

model RecurringExpense {
  id            String    @id @default(cuid())
  amountPaise   Int // integer paise, never floats
  categoryId    String
  paymentMethod String // CASH | CARD | UPI | NET_BANKING | WALLET | OTHER
  merchant      String?
  notes         String?
  frequency     String // WEEKLY | MONTHLY | YEARLY
  interval      Int       @default(1) // repeat every N periods
  startDate     DateTime // UTC midnight — first occurrence, anchors the schedule
  endDate       DateTime? // UTC midnight — last possible occurrence (inclusive), null = forever
  nextDate      DateTime // UTC midnight — next occurrence to materialize
  isActive      Boolean   @default(true) // false = paused or ended
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  expenses Expense[] // occurrences materialized so far

  @@index([isActive, nextDate])
}

model Budget {
  id         String   @id @default(cuid())
  categoryId String? // null = overall monthly budget
  month      String // "YYYY-MM"
  limitPaise Int // integer paise
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  category Category? @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, month])
  @@index([month])
}

model WishlistItem {
  id         String   @id @default(cuid())
  title      String
  url        String? // product page on the store (optional — offline/to-store items allowed)
  store      String // AMAZON | FLIPKART | MYNTRA | ... | OTHER (validated union in app layer)
  imageUrl   String?
  pricePaise Int? // price tracked when added (or when logged)
  priority   String   @default("MEDIUM") // LOW | MEDIUM | HIGH
  status     String   @default("WANTED") // WANTED | ORDERED | BOUGHT | DROPPED
  notes      String?
  expenseId  String? // set when bought and logged as an expense (scalar link, no FK)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}
